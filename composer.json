{
    "name": "klyp/wordpress-core-installer",
    "description": "Composer plugin that installs WordPress core (packages of type wordpress-core) into a directory of your choice.",
    "type": "composer-plugin",
    "keywords": ["wordpress", "composer", "installer", "plugin"],
    "homepage": "https://github.com/klyp/wordpress-core-installer",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Klyp",
            "homepage": "https://klyp.co"
        }
    ],
    "support": {
        "issues": "https://github.com/klyp/wordpress-core-installer/issues",
        "source": "https://github.com/klyp/wordpress-core-installer"
    },
    "require": {
        "php": ">=5.6",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Klyp\\WordPressCoreInstaller\\": "src/"
        }
    },
    "extra": {
        "class": "Klyp\\WordPressCoreInstaller\\Plugin"
    }
}
